import { Button, VerticalBox, HorizontalBox, LineEdit } from "std-widgets.slint";
import { PkgList } from "components/pkg-list.slint";
import { UiState, UiEvents } from "globals.slint";
export * from "globals.slint";

export component TitleBar inherits WindowMoveArea {
    height: 24px;
    HorizontalLayout {
        spacing: 10px;
        Text {
            vertical-alignment: TextVerticalAlignment.center;
            horizontal-stretch: 0;
            text: "fasciculus";
        }

        LineEdit {
            placeholder-text: "Package Name";
            horizontal-stretch: 1;
            height: 24px;
            accepted(text) => {
                UiEvents.search-pkg(text);
            }
            edited(name) => {
                UiState.search-pkg-by-name = name;
            }
        }

        HorizontalLayout {
            Button {
                colorize-icon: true;
                icon: @image-url("icons/minus-small.png");
                icon-size: 15px;
                height: 24px;
                clicked => {
                    UiEvents.minimize();
                }
            }
            Button {
                colorize-icon: true;
                icon: @image-url("icons/square.png");
                icon-size: 15px;
                height: 24px;
                clicked => {
                    UiEvents.maximize();
                }
            }
            Button {
                colorize-icon: true;
                icon: @image-url("icons/cross-small.png");
                icon-size: 15px;
                height: 24px;
                clicked => {
                    UiEvents.quit();
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    preferred-width: 1000px;
    preferred-height: 900px;
    no-frame: false;
    resize-border-width: 3px;
    default-font-size: 16px;
    VerticalBox {
        spacing: 20px;
        TitleBar {}
        PkgList {}
    }
}

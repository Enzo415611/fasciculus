import { ListView } from "std-widgets.slint";
import { UiState } from "../main-window.slint";
import { Package } from "../globals.slint";
component PkgButton inherits Rectangle {
    in property <Package> pkg;
    callback clicked;
    HorizontalLayout {
        Text {
            text: pkg.name;
        }

        TouchArea {
            clicked => {clicked()}
        }
    }
}

export component PkgList inherits Rectangle {
    ListView {
        for pkg in UiState.pkgs: PkgButton {
            pkg: pkg;
            clicked => {

            }
        }
    }
}
